---
import '@chirag127/oz-tokens-base'
import '@chirag127/oz-chrome/styles.css'
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/archivo'
import '../styles/theme.css'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz brand — AI brand-kit generator',
  description = 'Describe a brand, get a full identity: palette, font pairing, tagline, voice, and a logo-concept prompt. Live-preview a mock landing card and export design tokens (CSS/JSON). 100% in your browser — no upload, no signup.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <OzToolShell site="brand" title="brand studio">
      <slot />
      <Fragment slot="footer">
        <a href="https://github.com/chirag127/oriz-palette-ai">source</a>
        <span>100% client-side · no upload · no signup</span>
      </Fragment>
    </OzToolShell>
  </body>
</html>
